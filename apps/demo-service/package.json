{
  "name": "@signalforge/demo-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./scenarios": {
      "types": "./src/scenarios.ts",
      "development": "./src/scenarios.ts",
      "import": "./dist/scenarios.js"
    }
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--conditions=development node --import tsx src/index.ts",
    "dev:watch": "cross-env NODE_OPTIONS=--conditions=development tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "pg": "^8.23.1",
    "@signalforge/contracts": "workspace:*",
    "@signalforge/domain": "workspace:*",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
